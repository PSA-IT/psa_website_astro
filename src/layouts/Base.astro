---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

interface Props { title?: string; description?: string; }
const {
  title,
    description = "Physician Specialists in Anesthesia provides anesthesia, acute pain and critical care at Emory Saint Joseph's Hospital and surgery centers across Atlanta.",
} = Astro.props;

const fullTitle = title ? `${title} | Physician Specialists in Anesthesia` : 'Physician Specialists in Anesthesia | Atlanta anesthesia care';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/', Astro.site);

// Netlify sets URL to the site's primary address. Until psa-online.net is moved to this
// site, that's a *.netlify.app preview address, so we tell search engines not to index it.
const primaryUrl = process.env.URL || '';
const isPreview = primaryUrl !== '' && !primaryUrl.includes('psa-online.net');


// Image shown when a page is shared on LinkedIn, Facebook, texts, etc. (public/og-image.png)
const shareImage = new URL('/og-image.png', Astro.site).href;

// Structured data: tells Google who PSA is. Added to the homepage only.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  '@id': 'https://psa-online.net/#organization',
  name: site.name,
  legalName: site.legalName,
  alternateName: site.short,
  url: 'https://psa-online.net/',
  logo: new URL('/logo.png', Astro.site).href,
  image: shareImage,
  description,
  medicalSpecialty: 'https://schema.org/Anesthesia',
  telephone: '+1-404-257-1415',
  faxNumber: '+1-404-851-1649',
  email: site.emails.info,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5671 Peachtree Dunwoody Road, Suite 530',
    addressLocality: 'Atlanta',
    addressRegion: 'GA',
    postalCode: '30342',
    addressCountry: 'US',
  },
  areaServed: { '@type': 'City', name: 'Atlanta' },
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="google-site-verification" content="1RhWB6w4eWLEN9pOnb9BfdVvyDnAQXyL984xo_Oj4zw" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0069aa" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Physician Specialists in Anesthesia" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Physician Specialists in Anesthesia logo" />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Metricool analytics (carried over from the previous site) -->
    <script is:inline>function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"365df93e175762bcb82f48a86326e0d6"})});</script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
