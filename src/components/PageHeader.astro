---
import Trace from './Trace.astro';
interface Props { title: string; intro?: string; }
const { title, intro } = Astro.props;
---
<section class="page-header">
  <div class="wrap">
    <h1>{title}</h1>
    {intro && <p class="lede measure">{intro}</p>}
    <slot />
  </div>
  <Trace type="ekg" beats={8} class="page-trace" />
</section>

<style>
  .page-header { background: var(--mist); padding-top: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .page-header h1 { max-width: 20ch; }
  .page-header .lede { margin-bottom: 0; }
  .page-header :global(.page-trace) { height: 2.5rem; margin-top: 2rem; opacity: 0.55; }
</style>
