---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="contact">
      <p class="name">{site.legalName}</p>
      <address>
        {site.address[0]}<br />{site.address[1]}
      </address>
      <p>
        Phone <a href={site.phoneHref}>{site.phone}</a><br />
        Fax {site.fax}<br />
        <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a>
      </p>
    </div>

    <nav aria-label="Patients">
      <h2>Patients</h2>
      <ul>
        <li><a href={site.payBill} target="_blank" rel="noopener">Pay a bill</a></li>
        <li><a href="/pt_info#billing">Billing questions</a></li>
        <li><a href="/pt_info#forms">Forms</a></li>
        <li><a href="/pt_info#faq">Common questions</a></li>
        <li><a href="/osa">Sleep apnea and surgery</a></li>
      </ul>
    </nav>

    <nav aria-label="Practice">
      <h2>Practice</h2>
      <ul>
        <li><a href="/about">About PSA</a></li>
        <li><a href="/staff">Our team</a></li>
        <li><a href="/awards">Awards and recognition</a></li>
        <li><a href="/careers">Careers</a></li>
        <li><a href="/contact_us">Contact</a></li>
      </ul>
    </nav>

    <nav aria-label="Policies and social media">
      <h2>Policies</h2>
      <ul>
        <li><a href="/about#compliance">Compliance</a></li>
        <li><a href="/about#privacy_statement">Privacy</a></li>
        <li><a href="/patient_forms/PSA%20-%20No%20Surprises%20Disclosure.pdf">No Surprises Act disclosure</a></li>
      </ul>
      <h2 class="follow">Follow us</h2>
      <ul class="social">
        <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
        <li><a href={site.social.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={site.social.yelp} rel="noopener">Yelp</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.legalName}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #d9e3ec; padding-top: 3.5rem; font-size: 0.975rem; }
  .site-footer a { color: var(--white); text-decoration-color: rgba(255, 255, 255, 0.4); }
  .site-footer a:hover { color: var(--white); text-decoration-color: var(--white); }
  .site-footer :focus-visible { outline-color: var(--white); }
  .grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .contact { grid-column: span 1; }
  .name { font-family: var(--serif); font-size: 1.2rem; color: var(--white); margin-bottom: 0.75rem; }
  address { font-style: normal; margin-bottom: 1rem; }
  h2 { font: 650 0.95rem/1.3 var(--sans); color: var(--white); margin-bottom: 0.85rem; }
  .follow { margin-top: 1.75rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li + li { margin-top: 0.5rem; }
  .social { display: flex; gap: 1.25rem; }
  .social li + li { margin-top: 0; }
  .legal { border-top: 1px solid rgba(255, 255, 255, 0.15); margin-top: 3rem; padding-block: 1.25rem; font-size: 0.875rem; color: #a9bccc; }
  .legal p { margin: 0; }
</style>
